# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

VITE_MAX_FILE_SIZE=524288000
VITE_MAX_TRANSFER_SIZE=1073741824
VITE_MAX_FILES_PER_TRANSFER=50
VITE_WEBRTC_CHUNK_SIZE=65536
VITE_QR_EXPIRY_SECONDS=120

# WebRTC STUN Server (default is Google STUN)
VITE_STUN_URL=stun:stun.l.google.com:19302

# Optional TURN Relay Credentials for production NAT traversal
# VITE_TURN_URL=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-password
